{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2020",
        "outDir": "scripts-dist",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowJs": false,
        "isolatedModules": false,
        "strict": false,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/plugins/iconify/**/*.ts"
    ]
}
